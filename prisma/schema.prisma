generator client {
  provider = "prisma-client-js"
  // previewFeatures = [ "driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Singleton: holds the current GST/tax config editable from the admin dashboard.
// The row is always upserted with id "singleton"; never create a second row.
model TaxConfiguration {
  id        String   @id @default("singleton")
  gstRate   Float
  sacCode   String
  gstin     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// Singleton: site-wide branding, default SEO and contact details, editable from
// the admin dashboard. Falls back to the literals in constructMetadata /
// src/constants when the row is missing.
model SiteConfig {
  id              String   @id @default("singleton")
  siteName        String
  metaTitle       String
  metaDescription String   @db.Text
  keywords        String[]
  ogImage         String
  bookingNumbers  String[]
  contactEmail    String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// One row per toggleable public page or nav entry. `key` is a stable slug the
// code checks (e.g. "nav.gallery"); `label` only drives the admin list.
model SiteSectionVisibility {
  key       String   @id
  label     String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// Singleton: boat-wide booking limits editable from the admin dashboard.
// The row is always upserted with id "singleton"; never create a second row.
// Falls back to src/constants/config/business.ts when the row is missing.
model BookingConfig {
  id                        String   @id @default("singleton")
  maxBoatSeat               Int      @default(150)
  defaultMinLeadTimeHours   Float    @default(2)
  defaultMinNewBookingCount Int      @default(30)
  createdAt                 DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// add description
//
model Payments {
  id            String    @id @default(cuid())
  totalAmount   Int
  baseAmount    Int       @default(0)
  gstRate       Float     @default(0)
  gstAmount     Int       @default(0)
  gstin         String?
  sacCode       String?
  advancePaid   Int
  discount      Int
  modeOfPayment String
  Booking       Booking[]
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
}

model Booking {
  id            String @id @default(cuid())
  numOfChildren Int
  numOfAdults   Int
  numOfBaby     Int
  description   String @db.Text()

  //Change this to schedule (Schedules are tied up with the Booking.)
  paymentsId String
  payment    Payments @relation(fields: [paymentsId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  Events     Events[]

  // Set when this booking originated from an admin-generated payment link.
  BookingLink BookingLink?

  @@index([userId]) // For user's bookings queries
  @@index([scheduleId]) // For schedule-based queries
  @@index([paymentsId]) // For payment lookups
  @@index([createdAt]) // For date-based filtering
  @@index([userId, createdAt]) // Composite for user's recent bookings
}

enum BOOKING_LINK_STATUS {
  ACTIVE
  PAID
  EXPIRED // advisory only — expiry is evaluated lazily against expiresAt
  CANCELLED
}

enum BOOKING_LINK_PAYMENT_TYPE {
  ADVANCE // advancePercent of the grand total, remainder collected offline
  FULL
}

/// Admin-generated shareable booking/payment link (/book/<token>).
/// Snapshots the package + pricing at generation time so the price quoted to the
/// customer can never drift from what the admin promised on the phone.
model BookingLink {
  id     String              @id @default(cuid())
  token  String              @unique
  status BOOKING_LINK_STATUS @default(ACTIVE)

  // ---- what is being sold ------------------------------------------------
  packageId       String
  Package         Package        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  scheduleDay     DateTime       @db.Date()
  schedulePackage SCHEDULED_TIME

  /// The departure this link was sold against, frozen at generation time — the
  /// same principle as the price snapshot below.
  ///
  /// Without this the sailing time is re-derived from the LIVE package at pay
  /// time, so an admin editing a package's departure silently moves every
  /// outstanding link, including ones already sent to customers.
  ///
  scheduleStartsAt DateTime @db.Timestamptz(3)
  scheduleEndsAt   DateTime @db.Timestamptz(3)

  // Hint only. The schedule is re-resolved at pay time, since one may be
  // created between generation and payment.
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  // ---- pricing snapshot (PAISE, GST-exclusive — same unit as Package) -----
  adultPricePaise Int
  childPricePaise Int
  gstRate         Float

  paymentType    BOOKING_LINK_PAYMENT_TYPE
  advancePercent Int                       @default(50)

  // ---- optional admin prefill (the customer may edit all of these) --------
  prefillName       String?
  prefillEmail      String?
  prefillPhone      String?
  prefillAdultCount Int     @default(0)
  prefillChildCount Int     @default(0)
  prefillBabyCount  Int     @default(0)

  // ---- written when the customer creates a Razorpay order ----------------
  razorpayOrderId   String?
  quotedTotalPaise  Int?
  payableNowPaise   Int?
  orderAdultCount   Int?
  orderChildCount   Int?
  orderBabyCount    Int?
  orderName         String?
  orderEmail        String?
  orderPhone        String?
  reservedBookingId String?

  // ---- written by the order.paid webhook ---------------------------------
  bookingId String?   @unique
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  paidAt    DateTime? @db.Timestamptz(3)

  expiresAt         DateTime @db.Timestamptz(3)
  allowBelowMinimum Boolean  @default(true)
  createdBy         String? // session.user.id — there is no Admin table, so no FK
  adminNote         String?  @db.Text()
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([packageId])
  @@index([scheduleDay])
  @@index([status, scheduleDay])
}

model User {
  id       String    @id @default(cuid())
  name     String
  email    String?
  contact  String?
  bookings Booking[]

  @@index([email]) // For login/lookup by email
  @@index([contact]) // If used for contact-based lookups
}

model FoodMenu {
  id      String    @id @default(cuid())
  name    String
  Package Package[]
}

enum SCHEDULED_TIME {
  BREAKFAST
  LUNCH
  SUNSET
  DINNER
  CUSTOM
}

enum SCHEDULE_STATUS {
  BLOCKED //single button value change
  MAINTENANCE // removed.
  EXCLUSIVE // if the package is exclusive
  AVAILABLE // if common package and online user's are searchable.
}

model Schedule {
  id String @id @default(cuid())

  /// The IST calendar day this sailing belongs to.
  ///
  /// KEPT alongside `startsAt` on purpose. It is what the customer actually
  /// picked, the grouping key for every calendar screen, the term
  /// `resolveScheduleForPackageDate` matches on to decide which schedule a
  /// payment attaches to, and the only thing `groupBy(['day'])` can use.
  /// Deriving it from `startsAt` would need `AT TIME ZONE` per row and lose the
  /// index.
  ///
  /// INVARIANT: (startsAt AT TIME ZONE 'Asia/Kolkata')::date = day
  /// Enforced as a CHECK constraint in 004_contract.sql, and asserted by
  /// prisma/sql/2026-08-tz/002_verify.sql.
  day DateTime @db.Date()

  /// Departure and return as absolute instants, resolved ONCE at write time
  /// from (day, IST time-of-day) via `resolveSailingInstants`.
  ///
  /// Everything downstream — the lead-time gate, link expiry, slot labels,
  /// sorting — reads these and parses nothing. `endsAt` may land on the day
  /// after `day` for a sailing that crosses midnight; that is why it is an
  /// instant and not a second time-of-day column.
  ///
  /// NULL only for BLOCKED rows, which mark "this slot is closed on this day"
  /// and have no sailing at all. 229 such rows in production, referenced by
  /// zero bookings — which is what makes nullable safe here.
  startsAt DateTime? @db.Timestamptz(3)
  endsAt   DateTime? @db.Timestamptz(3)

  /// True when this schedule's times differ from its package's defaults — the
  /// old fromTime/toTime override. Informational, for the admin UI only.
  isTimeOverridden Boolean @default(false)

  packageId       String?
  schedulePackage SCHEDULED_TIME
  scheduleStatus  SCHEDULE_STATUS
  Package         Package?        @relation(fields: [packageId], references: [id])
  Booking         Booking[]
  BookingLink     BookingLink[]
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  /// Nothing at the DB level previously stopped two rows sharing a (day, slot),
  /// which is why resolveScheduleForPackageDate has to disambiguate at pay
  /// time. Production is already clean, so this builds as-is.
  @@unique([day, schedulePackage])
  @@index([day]) // Essential for date-based queries
  @@index([packageId]) // For package-schedule relationships
  @@index([scheduleStatus]) // For filtering by status
  @@index([day, scheduleStatus]) // Composite for available schedules on specific days
  @@index([packageId, day]) // For package availability queries
  @@index([startsAt]) // "next sailing", lead-time sweeps
  @@index([scheduleStatus, startsAt]) // replaces the lexicographic (day, fromTime) ordering
}

model Amenities {
  id      String        @id @default(cuid())
  items   AmenityItem[]
  Package Package[]
}

/// One bullet on a package's amenities list. Replaces the bare `String[]`,
/// which had no per-item identity and so could not be reordered or hidden
/// individually from the admin dashboard.
model AmenityItem {
  id          String    @id @default(cuid())
  amenitiesId String
  amenities   Amenities @relation(fields: [amenitiesId], references: [id], onDelete: Cascade)
  label       String
  order       Int       @default(0)
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([amenitiesId, order])
}

enum PACKAGE_CATEGORY {
  BREAKFAST
  LUNCH
  SUNSET
  DINNER
  EXCLUSIVE
  CUSTOM
}

model Package {
  id          String @id @default(cuid())
  title       String
  packageType String
  description String
  childPrice  Int
  adultPrice  Int
  amenitiesId String

  /// Sailing length in MINUTES. With `startMinutesIst` this is the single
  /// source of the return time: end = startMinutesIst + duration. Previously
  /// this duplicated (toTime - fromTime) and the two could drift; they were
  /// verified identical for all 9 production packages before the split was
  /// removed.
  duration   Int
  slug       String @unique
  foodMenuId String

  /// Departure time of day, MINUTES FROM MIDNIGHT in Asia/Kolkata. 0..1439.
  /// 540 = 09:00, 1050 = 17:30.
  ///
  /// Deliberately NOT an instant: a package departs at 09:00 IST on every date
  /// it runs, so the wall-clock time is the stable fact and the instant is
  /// derived per date (see `resolveSailingInstants` in src/lib/datetime.ts).
  /// The instants themselves live on Schedule.startsAt/endsAt.
  ///
  /// Replaces `fromTime`/`toTime`, which stored "09:00:AM" — a bespoke
  /// three-colon 12-hour format that had to be re-parsed at every read and had
  /// no DB-level format guarantee.
  ///
  startMinutesIst Int
  amenities       Amenities        @relation(fields: [amenitiesId], references: [id], onDelete: Cascade)
  food            FoodMenu         @relation(fields: [foodMenuId], references: [id], onDelete: Cascade)
  packageCategory PACKAGE_CATEGORY

  /// Hides the package from public discovery — home carousel, /search and the
  /// nav dropdown — and 404s its page. Deliberately NOT applied to booking-link
  /// or admin lookups: links already issued and existing bookings must keep
  /// resolving after a package is hidden.
  isVisible Boolean @default(true)

  /// Booking rules, per package. These used to live in a `BookingRule` table
  /// keyed by SCHEDULED_TIME, which meant every DINNER package shared one
  /// cutoff — a 4-hour dinner could not be given more notice than a 2-hour one.

  /// Hours before departure after which bookings close.
  /// null = follow BookingConfig.defaultMinLeadTimeHours.
  minLeadTimeHours Float?

  /// Minimum party size for opening a brand-new schedule.
  /// null = follow the default; 0 = no minimum at all; n = exactly n.
  minNewBookingCount Int?

  /// When false the package is still listed but takes enquiries rather than
  /// online bookings. Distinct from `isVisible`, which removes it entirely.
  isBookableOnline Boolean        @default(true)
  Schedule         Schedule[]
  packageImage     PackageImage[]
  PackageSeo       PackageSeo[]
  BookingLink      BookingLink[]
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([slug, id])
  @@index([packageCategory]) // For filtering by category
  @@index([packageType]) // If used for filtering
  @@index([adultPrice]) // For price-based sorting/filtering
  @@index([childPrice]) // For price-based sorting/filtering
}

enum IMAGE_USE {
  PROD_FEATURED
  PROD_THUMBNAIL
  COMMON
}

enum PROCESSING_STATUS {
  PROCESSING
  FAILED
  SUCCESS
}

model Events {
  id                    String            @id @unique @default(cuid())
  eventId               String
  description           String?
  FailedCount           Int
  status                PROCESSING_STATUS
  lastProcessingAttempt DateTime          @default(now()) @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  payload               Json?
  metadata              Json?

  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId String?

  @@index([eventId])
  @@index([status]) // For filtering by processing status
  @@index([createdAt]) // For time-based queries
  @@index([status, createdAt]) // For recent failed events, etc.
}

model Image {
  id           String         @id @unique @default(cuid())
  fileKey      String
  url          String
  alt          String
  ImageUse     IMAGE_USE[]    @default([COMMON])
  packageImage PackageImage[]
  Blog         Blog[]
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([fileKey]) // For file-based lookups
  @@index([ImageUse]) // For filtering by usage type
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id         String     @id @default(cuid())
  author     String
  title      String
  blogSlug   String     @unique
  shortDes   String     @db.Text
  content    String     @db.Text
  image      Image      @relation(fields: [imageId], references: [id], onDelete: Restrict)
  imageId    String
  banner     String?
  blogStatus BlogStatus
  BlogSeo    BlogSeo[]
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([blogSlug])
  @@index([blogStatus])
  @@index([author])
  @@index([createdAt])
  @@index([blogStatus, createdAt])
}

model PackageImage {
  id        String    @id @unique @default(cuid())
  packageId String
  ImageUse  IMAGE_USE @default(COMMON)
  imageId   String
  package   Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  image     Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([ImageUse])
  @@index([packageId, ImageUse])
}

model Seo {
  id             String       @id @default(cuid())
  title          String
  description    String
  keywords       String[]
  canonicalUrl   String
  ogTitle        String
  ogDescription  String
  ogImage        String
  structuredData Json
  metaRobots     String
  PackageSeo     PackageSeo[]
  BlogSeo        BlogSeo[]
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
}

model PackageSeo {
  id        String   @id @unique @default(cuid())
  seoId     String
  seo       Seo      @relation(fields: [seoId], references: [id])
  packageId String
  package   Package  @relation(fields: [packageId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model BlogSeo {
  id        String   @id @unique @default(cuid())
  seoId     String
  seo       Seo      @relation(fields: [seoId], references: [id])
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}
